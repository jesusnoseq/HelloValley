# Copy to .env.local. With no project id the client uses the local emulators under
# demo-hellovalley (`npm run emulators`), which needs no real keys.
# VITE_SERVER_URL=http://127.0.0.1:2567
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_EMULATORS=true
# App Check (build plan M36; a real project only). The reCAPTCHA Enterprise site key of the web
# app, and in development a debug token registered in the console (leave it empty once to get one
# printed in the browser console). Keep both in .env.local, never in git.
# VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# VITE_APPCHECK_DEBUG_TOKEN=
#
# Game server (packages/server) environment:
#   FIREBASE_PROJECT_ID   unset or demo-* = Auth emulator (127.0.0.1:9099 or FIREBASE_AUTH_EMULATOR_HOST)
