{
  "name": "hellovalley",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/client",
    "packages/server"
  ],
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=11.16.0 <12"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.16.0 <12",
      "onFail": "error"
    }
  },
  "allowScripts": {},
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors blue,green --kill-others-on-fail \"npm run dev -w @hellovalley/server\" \"npm run dev -w @hellovalley/client\"",
    "emulators": "firebase emulators:start --project demo-hellovalley",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-hellovalley \"vitest run tests/rules\"",
    "lint": "eslint .",
    "deps:check": "node scripts/check-dependencies.mjs",
    "deps:audit": "npm audit",
    "assets:build": "node scripts/assets-build.mjs",
    "assets:optimize": "node tools/optimize-assets.mjs",
    "assets:contact-sheet": "node scripts/assets-build.mjs --no-optimize --contact-sheet auto",
    "assets:fixtures": "node tools/fixtures/make-test-kit.mjs",
    "seed:tts": "tsx tools/seed/seed-tts.ts",
    "seed:labels": "tsx tools/seed/seed-labels.ts",
    "seed:barks": "tsx tools/seed/seed-barks.ts",
    "seed:quests": "tsx tools/seed/seed-quests.ts",
    "test:blender": "python -B -m unittest discover -s tools/blender/tests -t tools/blender"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "26.6.5",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase": "13.4.0",
    "globals": "17.14.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12"
  }
}
